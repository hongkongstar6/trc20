# Copy to .env and fill in. Never commit the real file.
#
# The two rental platform credentials are only needed on mainnet: Nile runs with
# energy.mode=fixed / trx_burn because neither platform has a test environment.

# --- infrastructure -----------------------------------------------------------
MYSQL_PASSWORD=wallet
MYSQL_ROOT_PASSWORD=rootpw
# docker compose 会为每个服务注入 MYSQL_DSN（指向 compose 里的 mysql 容器），
# 它优先于 configs/config.yaml 里的 mysql_server.dsn。直接在本机跑进程时，
# 可以在这里覆盖 DSN；留空则用 config.yaml 中的默认值。
#MYSQL_DSN=

# --- wallet keys --------------------------------------------------------------
# The mnemonic is only ever read by sign-service. In production use a secret
# manager, or better a KMS/HSM/Vault Transit backed key instead of a mnemonic.
WALLET_MNEMONIC=
WALLET_PASSPHRASE=

# Named system addresses, derived from the mnemonic with the paths in the config.
HOT_WALLET_ADDRESS=
FINANCE_WALLET_ADDRESS=
GAS_ACCOUNT_ADDRESS=

# --- service to service auth --------------------------------------------------
SIGN_TOKEN=
API_HMAC_SECRET=
# 可选的平台级回调地址（默认 notify.http.enabled=false，不启用）。充值到账默认
# 只按 merchant.callback_url 推送给对应商户。要启用平台级统一回调，需同时把
# notify.http.enabled 置 true 并填一个真实在跑的服务，否则 notify_outbox.last_error
# 会一直是 connection refused（事件不会丢，恢复后重投）。
# 容器访问宿主机上的服务用 host.docker.internal（compose 里已配 host-gateway 映射）。
#NOTIFY_URL=http://host.docker.internal:9000/wallet/callback
NOTIFY_URL=
NOTIFY_SECRET=
# api -> scanner 地址推送（布隆过滤器）。留空则只靠 scanner 定时增量同步。
BLOOM_TOKEN=

# --- chain nodes --------------------------------------------------------------
TRONGRID_API_KEY=
FULLNODE_ENDPOINT=

# --- energy providers (mainnet only) -----------------------------------------
GASSTATION_APP_ID=
GASSTATION_APP_SECRET=
# GasStation also requires the egress IP to be allowlisted on their dashboard.
GASSTATION_DEPOSIT_ADDRESS=

# The key is sent as a query parameter: keep full-URL logging off for this host.
TRONENERGYRENT_API_KEY=
TRONENERGYRENT_DEPOSIT_ADDRESS=
